#!/usr/bin/env bash
set -euo pipefail

script_dir="$(cd "$(dirname "$0")" && pwd)"
plugin_root="$(cd "${script_dir}/.." && pwd)"
skill_path="${plugin_root}/skills/using-ballclub/SKILL.md"

roster_sync_context() {
  local result status security_drift
  if ! result="$(node "${plugin_root}/scripts/bootstrap-roster.mjs")"; then
    printf '%s' "ballclub:roster-sync-degraded
Ballclub could not run its managed roster bootstrap. Continue with any eligible roster profiles currently exposed by the harness. If a required design, implementation, or review phase has no eligible player, report the limitation instead of substituting manager execution. Invoke setup-ballclub if the user asks to diagnose or repair the roster."
    return
  fi

  status="$(node -e 'const value=JSON.parse(process.argv[1]); process.stdout.write(value.status || "degraded")' "$result" 2>/dev/null || printf degraded)"
  security_drift="$(node -e '
    const value = JSON.parse(process.argv[1]);
    const warnings = Array.isArray(value.warnings) ? value.warnings : [];
    process.stdout.write(warnings.map(({ profile, fields = [] }) => `${profile} (${fields.join(", ")})`).join(", "));
  ' "$result" 2>/dev/null || true)"
  case "$status" in
    synced)
      printf '%s' "ballclub:roster-synced
Ballclub synchronized its bundled managed roster during SessionStart. The current session may have loaded the previous agent catalog, so tell the user briefly to start a fresh session before delegating to the updated players. Do not start a setup interview."
      ;;
    conflicts)
      local conflicts
      conflicts="$(node -e 'const value=JSON.parse(process.argv[1]); process.stdout.write((value.conflicts || []).join(", "))' "$result" 2>/dev/null || true)"
      printf '%s' "ballclub:roster-conflicts
Ballclub preserved custom or conflicting agent files during automatic roster sync: ${conflicts}. Continue without overwriting them. Invoke setup-ballclub only when the user asks to inspect or repair these conflicts; forced replacement still requires explicit approval."
      ;;
    current)
      ;;
    *)
      printf '%s' "ballclub:roster-sync-degraded
Ballclub could not complete its managed roster bootstrap. Continue with any eligible roster profiles currently exposed by the harness. If a required design, implementation, or review phase has no eligible player, report the limitation instead of substituting manager execution. Invoke setup-ballclub if the user asks to diagnose or repair the roster."
      ;;
  esac

  if [[ -n "$security_drift" ]]; then
    printf '%s' "
ballclub:roster-security-drift
Ballclub preserved compatible custom agent instructions but detected drift in supported security fields: ${security_drift}. Do not overwrite automatically. Invoke setup-ballclub when the user asks to inspect or repair it."
  fi
}

escape_for_json() {
  local value="$1"
  value="${value//\\/\\\\}"
  value="${value//\"/\\\"}"
  value="${value//$'\n'/\\n}"
  value="${value//$'\r'/\\r}"
  value="${value//$'\t'/\\t}"
  printf '%s' "$value"
}

emit_context() {
  local context="$1"
  local escaped
  escaped="$(escape_for_json "$context")"

  printf '{\n  "hookSpecificOutput": {\n    "hookEventName": "SessionStart",\n    "additionalContext": "%s"\n  }\n}\n' "$escaped"
}

skill_content=""
if [[ ! -r "$skill_path" ]] || ! skill_content="$(cat "$skill_path" 2>/dev/null)" || [[ -z "$skill_content" ]]; then
  emit_context $'ballclub:bootstrap-unavailable\nThe using-ballclub skill could not be read. Continue without the SessionStart bootstrap and use native skill discovery.'
  exit 0
fi

bootstrap_marker="ballclub:bootstrap"
sync_context="$(roster_sync_context)"
printf -v bootstrap '<BALLCLUB>\n%s\n\nThe using-ballclub skill below is already active for this session. Do not load it again. For Ballclub routing, delegation, scoring, or appearance interpretation, invoke any installed Ballclub skill with even a 1%% chance of applying. For unrelated work, use normal host skill discovery instead of treating Ballclub as a global trigger. Invoking one skill does not automatically activate TDD, design, planning, worktrees, review, or any other skill. User instructions and repository rules take precedence.\n\n%s\n\n%s\n</BALLCLUB>' "$bootstrap_marker" "$sync_context" "$skill_content"
emit_context "$bootstrap"
