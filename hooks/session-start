#!/usr/bin/env bash
set -euo pipefail

script_dir="$(cd "$(dirname "$0")" && pwd)"
plugin_root="$(cd "${script_dir}/.." && pwd)"
skill_path="${plugin_root}/skills/using-ballclub/SKILL.md"

escape_for_json() {
  local value="$1"
  value="${value//\\/\\\\}"
  value="${value//\"/\\\"}"
  value="${value//$'\n'/\\n}"
  value="${value//$'\r'/\\r}"
  value="${value//$'\t'/\\t}"
  printf '%s' "$value"
}

emit_context() {
  local context="$1"
  local escaped
  escaped="$(escape_for_json "$context")"

  if [[ -n "${CLAUDE_PLUGIN_ROOT:-}" ]] && [[ -z "${COPILOT_CLI:-}" ]]; then
    printf '{\n  "hookSpecificOutput": {\n    "hookEventName": "SessionStart",\n    "additionalContext": "%s"\n  }\n}\n' "$escaped"
  else
    printf '{\n  "additionalContext": "%s"\n}\n' "$escaped"
  fi
}

skill_content=""
if [[ ! -r "$skill_path" ]] || ! skill_content="$(cat "$skill_path" 2>/dev/null)" || [[ -z "$skill_content" ]]; then
  emit_context $'ballclub:bootstrap-unavailable\nThe using-ballclub skill could not be read. Continue without the SessionStart bootstrap and use native skill discovery.'
  exit 0
fi

bootstrap_marker="ballclub:bootstrap"
printf -v bootstrap '<BALLCLUB>\n%s\n\nThe using-ballclub skill below is already active for this session. Do not load it again. If there is even a 1%% chance another installed skill applies, invoke it before responding or acting. Invoking one skill does not automatically activate TDD, design, planning, worktrees, review, or any other skill. User instructions and repository rules take precedence.\n\n%s\n</BALLCLUB>' "$bootstrap_marker" "$skill_content"
emit_context "$bootstrap"
