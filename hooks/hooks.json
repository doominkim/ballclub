{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/run-hook.cmd\" session-start",
            "shell": "bash",
            "async": false
          }
        ]
      },
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/run-hook.cmd\" session-update",
            "shell": "bash",
            "async": false
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "^(?:[1-5]setter|[1-4]batter|[1-3]bench|chief-coach|coach|assistant-coach)$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT:-$CLAUDE_PLUGIN_ROOT}/scripts/collect-appearance.mjs\"",
            "shell": "bash",
            "timeout": 10,
            "statusMessage": "Recording Ballclub plate appearance"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT:-$CLAUDE_PLUGIN_ROOT}/scripts/collect-appearance.mjs\"",
            "shell": "bash",
            "timeout": 10,
            "statusMessage": "Recording Ballclub manager appearance"
          }
        ]
      }
    ]
  }
}
